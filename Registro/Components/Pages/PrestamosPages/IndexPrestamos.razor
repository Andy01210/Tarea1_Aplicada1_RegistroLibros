@page "/Prestamos"
@using SQLitePCL
@rendermode InteractiveServer


@inject NavigationManager Navigation

<PageTitle>Pretamos</PageTitle>

<div class= "container">

            @*Header*@
            <div class="card-header">
                <div class="card-title">
                    <h3> Consultas Prestamos</h3>
                </div>

                @*Body*@
                <div class="card-body">

                        @*Labels*@
                        <div class="row">

                            <div class = "col-3">
                                <label class ="form-label" for ="Filtro">
                                    <strong>Filtrar por</strong>
                                </label>
                            </div>

                            <div class = "col-3">
                                <label class ="form-label" for ="Filtro">
                                    <strong>Busqueda</strong>
                                </label>
                            </div>
                    
                        </div>

                    @*Inputs y botones*@
                    <div class="row">

                        @*FIltro*@
                        <div class="col-3">
                            <select class="form-select" @bind="filtro">
                                <option value ="">
                                    Elija una opcion
                                </option>

                                <option value ="">
                                    Estudiante
                                </option>

                                <option value ="">
                                    Libro
                                </option>

                            </select>
                        </div>

                

                    @*Busqueda*@
                        <div class = "col-4">

                            <div class="input-group">

                                <input class ="form-control"
                                    @bind="valorFiltro"
                                    placeholder="Buscar" />

                                <button type="button"
                                            class = "btn btn-outline-primary"
                                            @onclick="Buscar">

                                        buscar
                                    </button>
                            </div>
                        </div>

                        @*Restablecer*@
                        <div class = "col-auto">

                            <button type="button"
                                class = "btn btn-outline-secondary"
                                @onclick ="Restablecer">
                                
                                Restablecer
                            </button>
                        </div>
                    </div>

                <div class ="mt-3"
                     <QuickGrid  Items ="@ListaPrestamo.AsQueryable()" class ="table table-bordered" >
                        <PropertyColumn Property="@(p => p.PrestamoId)" Title = "Prestamo id" Align = "Align.Center" Sortable="true"/>
                        <PropertyColumn Property="@(p => p.Libro.Titulo)" Title = "Libro" Align = "Align.Center" Sortable="true"/>
                        <PropertyColumn Property="@(p => p.Estudiante.Nombre)" Title = "Estudiante" Align = "Align.Center" Sortable="true"/>
                        <PropertyColumn Property="@(p => p.FechaPrestamo)" Title = "Fecha del prestamo" Align = "Align.Center" Format = "dd-MM-yyy" Sortable="true"/>
                        <PropertyColumn Property="@(p => p.Fechadevolucion)" Title = "Fecha de devolucion" Align = "Align.Center" Format = "dd-MM-yyy" Sortable="true"/>

                        
                        <TemplateColumn Title = "Acciones"Align = "Align.Center" >
                            <div  
                            <a href="@($"/editar-prestamo/{context.PrestamoId}")" class="btn btn-outline-warning"> Editar</a>
                       
                            <a href="@($"/editar-prestamo/{context.PrestamoId}")" class="btn btn-outline-danger">Eliminar</a>

                            </div>
                            
                        </TemplateColumn>

                    </QuickGrid> 
                </div>
                   

                   

                            <p>
                                <strong>Cantidad: </strong> @ListaPrestamo.Count
                            </p>



                </div>
                    
            </div>

            @*Crear Prestamo*@
           <button type="button"
            class="btn btn-primary"
            @onclick="MostrarPantallaCrear">

        Crear Prestamo

    </button>
           
</div>
        





       
    

                @code
{

    public string? filtro{get; set;}

    public string? valorFiltro{get; set;}




    public List<Registro.Models.Prestamo> ListaPrestamo { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        ListaPrestamo = await Prestamos.Listar(p => p.PrestamoId > 0);
    }

    public void MostrarPantallaCrear()
    {
        Navigation.NavigateTo("/Crear-prestamos");
    }


    public void MostrarPantallaEditar()
    {
        Navigation.NavigateTo($"/editar-prestamo/");
    }


    public void MostrarPantallaEliminar()
    {
        Navigation.NavigateTo($"/editar-prestamo/");
    }

    public async Task Restablecer()
    {
        ListaPrestamo = await Prestamos.ListarTodo();
        filtro = string.Empty;
        valorFiltro = string.Empty;
    }

    public async Task Buscar()
        {
            if(valorFiltro.Trim() != "")
            {
                if(filtro == "Estudiante")
                {
                    ListaPrestamo = await Prestamos.Listar(p => p.Estudiante.Nombre.ToLower().Contains(valorFiltro.ToLower()));
                }
                if(filtro == "Libro")
                {
                    ListaPrestamo = await Prestamos.Listar(p => p.Libro.Titulo.ToLower().Contains(valorFiltro.ToLower()));
                }



        }
    }


 }
