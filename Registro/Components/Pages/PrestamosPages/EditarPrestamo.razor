@page "/editar-prestamo/{PrestamoId:int}"
@rendermode InteractiveServer


@inject PrestamosServices PrestamosServices

@inject LibroService LibroServices

@inject EstudiantesServices EstudiantesServices

@inject NavigationManager Navigation

<PageTitle>Editar prestamo</PageTitle>

<div class="container mt-4">

    <div class="card">

        @*Encabezado*@
        <div class="card-header text-center">
            <h3>Editar Prestamo</h3>
        </div>

        @*Formulario*@
        <div class="card-body">

            @*PrestamoId*@
            <div class="mb-3">
                <label class="form-label">
                    PrestamoId
                </label>

                <input type="number"
                       class="form-control"
                       @bind="prestamo.PrestamoId" />
            </div>

               @*Libro*@
            <div class="mb-3">
                <label class="form-label">
                    Titulo Libro
                </label>

                <InputSelect class = "form-control" @bind-Value ="prestamo.LibroId" >
                    <option value = "0" >Seleccione un libro</option>

                    @foreach(Libro libro in ListaLibros){
                        <option value ="@libro.LibroId">@libro.Titulo</option>
                    }
                    </InputSelect>
            </div>

            @*Estudiante*@
            <div class="mb-3">
                <label class="form-label">
                    Nombre Estudiante
                </label>

                <InputSelect class = "form-control" @bind-Value ="prestamo.EstudianteId" >
                    <option value = "0" >Seleccione un Estudiante</option>

                    @foreach(Estudiante estudiante in ListaEstudiante){
                        <option value ="@estudiante.EstudianteId">@estudiante.Nombre</option>
                    }
                    </InputSelect>
            </div>

            @*fechaPrestamo*@
            <div class="mb-3">
                <label class="form-label">
                    Fecha Prestamo
                </label>

                <input type="date"
                       class="form-control"
                       @bind="prestamo.FechaPrestamo" />
            </div>

                
             @*fechaDevolucion*@
            <div class="mb-3">
                <label class="form-label">
                    Fecha Devolcuion
                </label>

                <input type="date"
                       class="form-control"
                       @bind="prestamo.Fechadevolucion" />
            </div>

            @*Mensaje*@
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-danger">
                    @mensaje
                </div>
            }

        </div>

        @*Botones*@
        <div class="card-footer">

            <div class="d-flex justify-content-center gap-2">

                @*Volver*@
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="Volver">
                    Volver
                </button>

                @*Modificar*@
                <button type="button"
                        class="btn btn-primary"
                        @onclick="Modificar">
                    Modificar
                </button>

                 @*Eliminar*@
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#exampleModal">
                        Eliminar
                    </button>
            </div>

        </div>

    </div>

</div>




<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
                        aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel">Confirmar eliminación</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    ¿Está seguro de que desea eliminar este libro?
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        Volver
                                    </button>
                                    <button type="button" class="btn btn-danger" @onclick="Eliminar">
                                        Eliminar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>


@code
{
    private Prestamo prestamo{get; set;} = new Prestamo();

    [Parameter]
    public int PrestamoId{get; set;}
    private List<Libro> ListaLibros = new List<Libro>();
    private List<Estudiante> ListaEstudiante = new List<Estudiante>();

    private string mensaje = "";


    protected override async Task OnInitializedAsync(){
        ListaLibros = await LibroServices.ObtenerTodos();
        ListaEstudiante = await EstudiantesServices.Listar();


        Registro.Models.Prestamo? resultado =
       await PrestamosServices.Buscar(PrestamoId);

        if (resultado != null)
        {
            prestamo = resultado;
        }
        else
        {
            mensaje = "No se encontró el estudiante.";
        }
    }


    private async Task Modificar()
    {
        mensaje = "";


        if(prestamo.LibroId == 0){
            mensaje = "No ha seleccionado ningun libro";
            return;
        }
        if(prestamo.EstudianteId == 0){
            mensaje = "No ha seleccionado un estudiane";
            return;
        }
        if(prestamo.FechaPrestamo == default){
            mensaje = "No ha ingresado ninguna fecha de prestamo";
            return;
        }
        if(prestamo.Fechadevolucion == default){
            mensaje = "No ha ingresado ninguna fecha e devolucion";
            return;
        }
        if(prestamo.FechaPrestamo > prestamo.Fechadevolucion){
            mensaje = "La fecha del prestamo no puede ser mayor que la fecha de devolucion";
            return;

        }

        bool guardado= await PrestamosServices.Modificar(prestamo);

        if(guardado){
            Navigation.NavigateTo("/Prestamos");
        }else{
            mensaje = "Ocurrio un error al modificar el prestamo";
        }
    }

    private async Task Eliminar()
    {
        bool resultado =
            await PrestamosServices.Eliminar(PrestamoId);

        if (resultado)
        {
            mensaje = "Prestamo Eliminado";
            Navigation.NavigateTo("/Prestamos");
        }
        else
        {
            mensaje = "Error al eliminar el prestamo.";
        }
    }

    public void Volver()
    {
        Navigation.NavigateTo("/Prestamos");
    }
}




