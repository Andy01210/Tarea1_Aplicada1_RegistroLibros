@page "/crear-Estudiante"
@rendermode InteractiveServer
@inject EstudiantesServices EstudiantesServices
@inject NavigationManager Navigation

<PageTitle>Crear Estudiante</PageTitle>

<EditForm Model="@estudiante">
<div class="container mt-4">

    <div class="card">

        @*Encabezado*@
        <div class="card-header text-center">
            <h3>Crear Estudiante</h3>
        </div>

        @*Formulario*@
        <div class="card-body ">

            @*EstudianteId*@
            <div class="mb-3">
                <label class="form-label">
                    EstudianteId
                </label>
                <input type="number"
                       class="form-control"
                       @bind="estudiante.EstudianteId" />
            </div>

            @*Nombre*@
            <div class="mb-3">
                <label class="form-label">
                    Nombre
                </label>
                <input type="text"
                       class="form-control"
                       @bind="estudiante.Nombre" />
            </div>

            @*Direccion*@
            <div class="mb-3">
                <label class="form-label">
                    Direccion
                </label>
                <input type="text"
                       class="form-control"
                       @bind="estudiante.Direccion" />
            </div>

            @*Email*@
            <div class="mb-3">
                <label class="form-label">
                    Email
                </label>
                <input type="text"
                       class="form-control"
                       @bind="estudiante.Email" />
            </div>

             @*Fecha de nacimiento*@
            <div class="mb-3">
                <label class="form-label">
                    FechaDeNacimiento
                </label>
                <input type="date"
                       class="form-control"
                       @bind="estudiante.FechaDeNacimiento" />
            </div>

            @*Mensaje*@
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-danger">
                    @mensaje
                </div>
            }

        </div>

        @*Botones*@
        <div class="card-footer">
            <div class="d-flex justify-content-center gap-2">

                @*Volver*@
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="Volver">
                    Volver
                </button>

                @*Guardar*@
                <button type="button"
                        class="btn btn-primary"
                        @onclick="Guardar">
                    Guardar
                </button>
            </div>
        </div>
    </div>

</div>
</EditForm>

@code {
    private Estudiante estudiante = new();
    private string mensaje = "";

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(estudiante.Nombre))
        {
            mensaje = "El nombre es obligatorio.";
            return;
        }
        if (string.IsNullOrWhiteSpace(estudiante.Direccion))
        {
            mensaje = "La direccion es obligatoria.";
            return;
        }
        if (string.IsNullOrWhiteSpace(estudiante.Email))
        {
            mensaje = "El email es obligatorio.";
            return;
        }
        if (estudiante.FechaDeNacimiento == default)
        {
            mensaje = "La fecha debe ser obligatoria.";
            return;
        }

        bool resultado = await EstudiantesServices.Guardar(estudiante);

        if (resultado)
        {
            Navigation.NavigateTo("/Estudiantes");
        }
        else
        {
            mensaje = "Error al guardar el estudiante. Intente nuevamente.";
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/Estudiantes");
    }
}